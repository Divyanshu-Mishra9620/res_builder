# Copy to client/.env (gitignored).
# Where the API lives. Vite only exposes VITE_-prefixed vars to the browser, and bakes them in at build time.
#   Local dev, calling the API directly:  VITE_API_URL=http://localhost:5070
#   Deployed frontend:                    VITE_API_URL=https://your-api.onrender.com   (set it in the host's env settings)
#   Empty: same origin, i.e. the Vite proxy in dev or the single-port build (npm run build && npm start)
# Whatever origin serves this client must be listed in the server's CORS_ORIGIN.
VITE_API_URL=
