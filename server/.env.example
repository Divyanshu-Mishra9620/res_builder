# Copy this file to server/.env (gitignored) and paste ONE key there, not here.
#
# Groq: free tier, no card needed; runs openai/gpt-oss-120b. Key: https://console.groq.com/keys
GROQ_API_KEY=
# Grok (xAI): grok-4.3. Paid; xAI has no free API tier. Key: https://console.x.ai
XAI_API_KEY=

# Optional: MongoDB for saved workspaces (local or a free Atlas cluster). Empty = in memory.
MONGODB_URI=

# Optional overrides
# LLM_PROVIDER=groq        # groq | xai, only needed if both keys are set
# LLM_MODEL=openai/gpt-oss-120b
# LLM_EFFORT=low           # reasoning_effort (default: low on Groq, to fit the free tier)
# Any other OpenAI-compatible API: set LLM_BASE_URL, LLM_API_KEY and LLM_MODEL
# PORT=5070
